{
  "name": "@scoobiii/parametrix",
  "private": false,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:k6": "bash scripts/k6/run_k6_suite.sh",
    "audit:cad": "tsx scripts/cad_engine_audit.ts",
    "cad:gear": "tsx scripts/cad/export_spur_gear_geometry.ts && QT_QPA_PLATFORM=offscreen freecadcmd scripts/cad/build_spur_gear_step.py && MPLCONFIGDIR=.cache/matplotlib python3 scripts/cad/render_spur_gear_views.py && QT_QPA_PLATFORM=offscreen MPLCONFIGDIR=.cache/matplotlib freecadcmd scripts/cad/verify_spur_gear_delivery.py && tsx scripts/cad/finalize_spur_gear_delivery.ts",
    "ci": "npm run lint && npm run test:coverage && npm run audit:cad && npm run build && npm run vuc:proof",
    "dev:vite": "vite --host 0.0.0.0 --port 5173",
    "dev:all": "tsx server.ts",
    "onboard": "bash scripts/onboard_anticagada.sh",
    "llm:install-qwen": "bash scripts/install_qwen_local.sh",
    "hermes:setup": "bash scripts/hermes/setup_parametrix_hermes.sh",
    "claw:setup": "bash scripts/hermes/setup_parametrix_claw.sh",
    "vuc:proof": "tsx scripts/generate_vuc_proof.ts",
    "ugee:validate": "node scripts/validate_ugee1000br.mjs",
    "ugee:kernel-gate": "tsx scripts/ugee1000br_kernel_gate.ts",
    "diagnose:env": "node scripts/diagnose-environment.mjs",
    "classify:tests": "node scripts/classify-tests.mjs",
    "package:check": "npm pack --dry-run",
    "ci:contract": "npm run diagnose:env -- --ci && npm run classify:tests",
    "quality:static": "node scripts/quality-suite.mjs --checks=inventory,scrum,gui,ux,a11y,load-balance --strict",
    "quality:runtime": "node scripts/quality-suite.mjs --checks=performance,stress,load-balance --strict",
    "quality:strict": "node scripts/quality-suite.mjs --strict"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "cfb": "^1.2.2",
    "d3": "^7.9.2",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "occt-import-js": "^0.0.23",
    "prom-client": "^15.1.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "ws": "^8.23.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  },
  "description": "Parametric CAD/CAE/CAM runtime, MCP adapters and VUC-verifiable agent integrations.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "packages",
    "plugins",
    "scripts/diagnose-environment.mjs",
    "scripts/classify-tests.mjs",
    "scripts/hermes/parametrix_mcp_stdio.py",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./packages/core/src/index.ts",
    "./adapters": "./packages/adapters/src/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "parametrix": "./packages/cli/bin/parametrix.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scoobiii/parametrIX.git"
  },
  "homepage": "https://scoobiii.github.io/parametrIX/"
}
